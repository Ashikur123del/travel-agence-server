datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id           String    @id @default(uuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  issuer       String?   // <--- এই লাইনটি যোগ করুন
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([identifier, value])
}




model HeroSlider {
  id           String   @id @default(cuid())
  image        String
  alt          String?  @default("Slide image")
  firstText    String
  highlightText String
  secondText   String
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hero_sliders")
}



model News {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  category      String
  categoryColor String   @default("from-amber-500 to-orange-500")
  excerpt       String
  content       String
  image         String
  date          String
  readTime      String   @default("3 min read")
  author        String   @default("Travel Desk")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}